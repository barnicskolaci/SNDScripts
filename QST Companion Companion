      sleep(1.004)
    end
    yield('/send NUMPAD0')
    sleep(1.005)

    if Svc.Condition[56] or Svc.Condition[34] then
      if (Svc.Targets.Target and Svc.Targets.Target:IsHostile() == true) or (Svc.Targets.Target and tostring(Entity.Target.Type):match("^EventObj") )then
        yield('/vnav movetarget')
      end
    end
end



