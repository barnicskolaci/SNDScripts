function FastCloseCheck(a, b, tol)
    tol = tol or 0.5
    return math.abs(a.X-b.X) < tol
       and math.abs(a.Y-b.Y) < tol
       and math.abs(a.Z-b.Z) < tol
end
-- Returns true if Entity.Player.Position is within delta units of the target coordinates
function IsPlayerCloseTo(x, y, z, delta)
    if Entity.Player == nil or Entity.Player.Position == nil then
        return false
    end
    local p = Entity.Player.Position
    delta = delta or 0.5
    local result = FastCloseCheck(p, {X=x, Y=y, Z=z}, delta)
    if debug then
        yield("/echo [QST] Debug: Checking if player is close to (" .. x .. ", " .. y .. ", " .. z .. ") with delta " .. delta .. " - Result: " .. tostring(result))
    end
    return result
end

