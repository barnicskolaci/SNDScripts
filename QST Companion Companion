-- Returns true if Entity.Player.Position is within delta units of the target coordinates
function IsInBox(x, y, z, delta)
    if Entity.Player == nil or Entity.Player.Position == nil then
        return false
    end

    local p = Entity.Player.Position
    delta = delta or 1
    return p.X > x - delta and p.X < x + delta
       and p.Y > y - delta and p.Y < y + delta
       and p.Z > z - delta and p.Z < z + delta
end
