-- Initialize position history

local positionHistory = {}

function CheckPosStuck()
    if Player.Entity == nil then
        return false
    end
    
    local currentPos = Player.Entity.Position
    
    -- Handle nil position
    if currentPos == nil then
        positionHistory = {}
        return false
    end
    
    -- Add current position to history
    table.insert(positionHistory, currentPos)
    
    -- Keep only last 3 positions
    if #positionHistory > 3 then
        table.remove(positionHistory, 1)
    end
    
    --[[ Debug: yield position history
    yield("/echo Position History: " .. tostring(#positionHistory) .. " entries")
    for i, pos in ipairs(positionHistory) do
        yield("/echo [" .. i .. "] " .. tostring(pos))
    end]]
    
    -- Check if we have 3 positions and they're all the same
    if #positionHistory == 3 then
        local pos1 = positionHistory[1]
        local pos2 = positionHistory[2]
        local pos3 = positionHistory[3]
        
        -- Compare Vector3 objects directly
        if pos1 == pos2 and pos2 == pos3 and Entity.Player and not Entity.Player.IsInCombat then
            yield("/echo Player is stationary - all 3 positions match")
            return true
        end
    end
    
    return false
end                        

function IsAddonReady(name)
    return Addons.GetAddon(name).Ready
end

function IsAddonExists(name)
    return Addons.GetAddon(name).Exists
end

function sleep(seconds)
    yield('/wait ' .. tostring(seconds))
end

function AddonHandler(addonConfigs)
    for _, config in ipairs(addonConfigs) do
        local Addon = config.addon
        local condition = config.condition
        
        -- Check custom condition if provided
        if condition and not condition() then
            goto skip_addon
        end

        if Entity.Player and Entity.Player.IsCasting then
            goto skip_addon
        end
        
        while IsAddonExists(Addon) do
            if config.command then
                config.command()
            else
                yield('/send DECIMAL')
                yield('/send DECIMAL')
            end
            sleep(2)
        end
        
        ::skip_addon::
    end
end

function HardTarget()
    yield('/vbm cfg aiconfig forbidactions false')
    sleep(0.1)
    if not Svc.Targets.Target or Svc.Targets.Target:IsHostile() == false then
      yield('/send TAB')
      sleep(1)
    end
    yield('/send NUMPAD0')
    sleep(1)
    if Svc.Condition[56] or Svc.Condition[34] then
      if Svc.Targets.Target and Svc.Targets.Target:IsHostile() == true or tostring(Entity.Target.Type):match("^EventObj") then
        yield('/vnav movetarget')
      end
    end
end

